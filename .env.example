# Environment Variables Template for LiftMaster Pro
# Copy this file to .env and fill in your values

# JWT Secret (REQUIRED - change this in production!)
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production

# MongoDB Connection (REQUIRED)
MONGODB_URI=mongodb://localhost:27017/deapseak

# Default Admin User (created on first run)
DEFAULT_ADMIN_EMAIL=admin@deapseak.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password
DEFAULT_ADMIN_FULLNAME=System Administrator

# Default Test Users (created via /api/init-test-data)
TEST_ADMIN_PASSWORD=secure_admin_password
TEST_TECH_PASSWORD=secure_tech_password
TEST_CLIENT_PASSWORD=secure_client_password
TEST_DISPATCHER_PASSWORD=secure_dispatcher_password

# Server Configuration
PORT=3001
NODE_ENV=development

# Security Settings
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS Settings
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# QR Code Settings
QR_EXPIRY_DAYS=365
QR_MAX_SCANS=10000

# Email Settings (for future use)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log