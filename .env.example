# ════════════════════════════════════════════════════════
# 🔐 DeapSeaK Environment Variables - EXAMPLE
# ════════════════════════════════════════════════════════
# ІНСТРУКЦІЯ:
# 1. Скопіюй цей файл: cp .env.example .env
# 2. Заповни РЕАЛЬНІ значення (API ключі, паролі)
# 3. НІКОЛИ не комічи .env на GitHub!
# ════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════
# 🗄️  MongoDB Configuration
# ════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/deapseak
DB_NAME=deapseak

# ════════════════════════════════════════════════════════
# 🔑 JWT Authentication
# ════════════════════════════════════════════════════════
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too

# ════════════════════════════════════════════════════════
# 📧 Brevo (Sendinblue) Email Service
# ════════════════════════════════════════════════════════
# Отримай ключі тут: https://app.brevo.com/settings/keys/api

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-email@example.com
SMTP_PASS=xsmtpsib-YOUR-SMTP-KEY-HERE

# API Key для програмного доступу
BREVO_API_KEY=xkeysib-YOUR-API-KEY-HERE

# Відправник (має бути верифікований в Brevo)
EMAIL_FROM=info@festlift.pt
EMAIL_FROM_NAME=FestLift

# ════════════════════════════════════════════════════════
# 🤖 AI Configuration (Optional)
# ════════════════════════════════════════════════════════
OPENAI_API_KEY=your-openai-api-key-if-needed

# ════════════════════════════════════════════════════════
# 🌐 Server Configuration
# ════════════════════════════════════════════════════════
PORT=5000
NODE_ENV=development

# ════════════════════════════════════════════════════════
# 📝 Logging
# ════════════════════════════════════════════════════════
LOG_LEVEL=info

# ════════════════════════════════════════════════════════
# �� ВАЖЛИВА ІНФОРМАЦІЯ ПРО БЕЗПЕКУ:
# ════════════════════════════════════════════════════════
# ⚠️  НІКОЛИ не комічи файл .env на GitHub!
# ⚠️  Використовуй різні ключі для dev/staging/production
# ⚠️  Регулярно ротуй (змінюй) API ключі
# ⚠️  Якщо ключ потрапив на GitHub - негайно згенеруй новий!
# ════════════════════════════════════════════════════════
