# Environment Variables Template for DeapSeaK v2
# Copy this file to .env and fill in your values

# Environment
NODE_ENV=development

# Server Configuration
PORT=3002
# Old api-server.js runs on 3001
# New modular backend runs on 3002

# MongoDB Connection (REQUIRED)
MONGODB_URI=mongodb://localhost:27017/deapseak
# For MongoDB Atlas use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/deapseak?retryWrites=true&w=majority

# JWT Authentication (REQUIRED - change in production!)
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_change_this_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Password Hashing
BCRYPT_ROUNDS=10

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=DeapSeaK <noreply@deapseak.com>

# File Upload Settings
MAX_FILE_SIZE=10485760
# 10MB in bytes
UPLOAD_DIR=./uploads

# CORS Settings
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
# Comma-separated list of allowed origins

# Client URL (for email links and redirects)
CLIENT_URL=http://localhost:3000

# QR Code Settings
QR_EXPIRY_DAYS=365
QR_BASE_URL=http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log