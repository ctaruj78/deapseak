# ═══════════════════════════════════════════════════════
# Caddyfile — HTTPS reverse proxy для FestLift на міні ПК
# Caddy автоматично бере SSL сертифікат від Let's Encrypt
# ═══════════════════════════════════════════════════════
#
# ВСТАНОВЛЕННЯ CADDY на Ubuntu/Debian:
#   sudo apt install -y debian-keyring debian-archive-keyring apt-transport-https
#   curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#   curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#   sudo apt update && sudo apt install caddy
#
# ЗАПУСК:
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# ═══════════════════════════════════════════════════════

festlift.pt {
    # Reverse proxy до Node.js сервера
    reverse_proxy localhost:5000

    # Заголовки безпеки (Caddy автоматично додає HTTPS redirect)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Логи
    log {
        output file /var/log/caddy/festlift.log
        format json
    }
}

# www → без www redirect
www.festlift.pt {
    redir https://festlift.pt{uri} permanent
}
