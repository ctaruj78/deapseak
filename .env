# Database  
MONGODB_URI=mongodb://localhost:27017/deapseak
MONGO_URI=mongodb://localhost:27017/deapseak

# Server
NODE_ENV=development
PORT=3001
WS_PORT=3002

# Security
JWT_SECRET=deapseak-super-secret-key-2024-change-in-production
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
