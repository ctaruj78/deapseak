# API Server
NODE_ENV=production
PORT=3001

# Web Ports
WEB_PORT_1=8080
WEB_PORT_2=8081

# Database (якщо потребується)
MONGODB_URI=mongodb://localhost:27017/deapseak

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# API Keys
API_KEY=your_api_key_here

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# Logging
LOG_LEVEL=info
