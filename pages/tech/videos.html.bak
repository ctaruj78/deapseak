<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Технік - Відеоінструкції</title>

    <!-- AdminLTE CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free/css/all.min.css">

    <style>
        .video-card {
            transition: all 0.3s ease;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .video-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        }

        .video-thumbnail {
            height: 200px;
            background: linear-gradient(135deg, #007bff, #6610f2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
        }

        .play-btn {
            background: linear-gradient(135deg, #dc3545, #c82333);
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

        .play-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Навігаційна панель -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Бічна панель -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="dashboard.html" class="brand-link">
                <span class="brand-text font-weight-light">Технік</span>
            </a>

            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                        <li class="nav-item"><a href="dashboard.html" class="nav-link"><i class="nav-icon fas fa-tachometer-alt"></i><p>Головна</p></a></li>
                        <li class="nav-item"><a href="tasks.html" class="nav-link"><i class="nav-icon fas fa-tasks"></i><p>Завдання</p></a></li>
                        <li class="nav-item"><a href="schedule.html" class="nav-link"><i class="nav-icon fas fa-calendar"></i><p>Розклад</p></a></li>
                        <li class="nav-item"><a href="tools.html" class="nav-link"><i class="nav-icon fas fa-tools"></i><p>Інструменти</p></a></li>
                        <li class="nav-item"><a href="knowledge-base.html" class="nav-link active"><i class="nav-icon fas fa-book"></i><p>База знань</p></a></li>
                        <li class="nav-item"><a href="support.html" class="nav-link"><i class="nav-icon fas fa-headset"></i><p>Підтримка</p></a></li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>Відеоінструкції</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="dashboard.html">Головна</a></li>
                                <li class="breadcrumb-item"><a href="knowledge-base.html">База знань</a></li>
                                <li class="breadcrumb-item active">Відеоінструкції</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Навчальні відео</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="card video-card">
                                                <div class="video-thumbnail">
                                                    <i class="fas fa-play-circle"></i>
                                                </div>
                                                <div class="card-body text-center">
                                                    <h5>Основи обслуговування ліфтів</h5>
                                                    <p class="text-muted">Вступний курс для нових техніків</p>
                                                    <button class="btn play-btn" onclick="playVideo('maintenance-basics.mp4')">
                                                        <i class="fas fa-play"></i> Переглянути
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card video-card">
                                                <div class="video-thumbnail">
                                                    <i class="fas fa-play-circle"></i>
                                                </div>
                                                <div class="card-body text-center">
                                                    <h5>Діагностика несправностей</h5>
                                                    <p class="text-muted">Як швидко знайти та усунути проблеми</p>
                                                    <button class="btn play-btn" onclick="playVideo('troubleshooting.mp4')">
                                                        <i class="fas fa-play"></i> Переглянути
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card video-card">
                                                <div class="video-thumbnail">
                                                    <i class="fas fa-play-circle"></i>
                                                </div>
                                                <div class="card-body text-center">
                                                    <h5>Безпека на роботі</h5>
                                                    <p class="text-muted">Правила безпеки при роботі з ліфтами</p>
                                                    <button class="btn play-btn" onclick="playVideo('safety-procedures.mp4')">
                                                        <i class="fas fa-play"></i> Переглянути
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Lift Management &copy; 2024</strong>
            Всі права захищені.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    <script>
        function playVideo(filename) {
            // Симуляція відтворення відео
            alert(`Відтворення ${filename} розпочато. У реальному додатку тут буде плеєр відео.`);
        }
    </script>
</body>
</html>