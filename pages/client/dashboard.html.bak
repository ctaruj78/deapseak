        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>Панель клієнта</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="dashboard.html">Дашборд</a></li>
                                <li class="breadcrumb-item active">Панель</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Welcome Banner -->
                    <div class="row">
                        <div class="col-12">
                            <div class="welcome-banner fade-in">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h2>Вітаємо, <span id="userName">Клієнт</span>! 👋</h2>
                                        <p class="mb-1">Статус ваших ліфтів: <span class="status-badge all-operational" id="statusBadge">Всі працюють</span></p>
