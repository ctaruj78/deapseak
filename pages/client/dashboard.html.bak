                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Клієнтська панель &copy; 2024</strong>
            <div class="float-right d-none d-sm-inline-block">
                <small id="connectionStatus"><i class="fas fa-wifi text-success"></i> Online</small>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    <!-- Client Dashboard JS -->
    <script src="../../assets/js/modules/client-dashboard.js"></script>

    <script>
        // Функція виходу
        function logout() {
            if (confirm('Ви впевнені, що хочете вийти з системи?')) {
                localStorage.removeItem('authToken');
                localStorage.removeItem('userData');
                window.location.href = 'login.html';
            }
        }

        // Ініціалізація
        $(document).ready(function() {
            // Ініціалізація AdminLTE
            $('[data-widget="pushmenu"]').PushMenu();
            
            // Оновлення часу
            setInterval(() => {
                $('#lastUpdateTime').text(new Date().toLocaleTimeString('uk-UA'));
            }, 1000);

            // Темна тема
            $('#darkModeToggle').on('click', function() {
                $('body').toggleClass('dark-mode');
                $(this).find('i').toggleClass('fa-moon fa-sun');
                clientDashboard.showNotification(
                    $('body').hasClass('dark-mode') ? 'Темна тема увімкнена' : 'Темна тема вимкнена', 
                    'success'
                );
            });

            // Перевірка з'єднання
            setInterval(() => {
                const online = navigator.onLine;
                $('#connectionStatus').html(
                    online ? 
                    '<i class="fas fa-wifi text-success"></i> Online' : 
                    '<i class="fas fa-wifi-slash text-danger"></i> Offline'
                );
            }, 30000);

            // Ініціалізація клієнтських даних з API
            initializeClientDashboard();

            // Перевірка чи завантажено client-dashboard.js
            if (typeof ClientDashboard === 'undefined') {
                console.error('ClientDashboard клас не завантажено!');
            } else {
                window.clientDashboard = new ClientDashboard();
            }

            /**
             * Ініціалізація клієнтської панелі з даними API
             */
            async function initializeClientDashboard() {
                console.log('🔄 Ініціалізація клієнтської панелі...');
                
                try {
                    // Завантажуємо дані користувача
                    const userData = await loadClientProfile();
                    
                    // Оновлюємо інтерфейс користувача
                    updateClientInterface(userData);
                    
                    // Завантажуємо дані дашборду
                    const [myLifts, myRequests, notifications] = await Promise.all([
                        loadClientLifts(),
                        loadClientRequests(),
                        loadClientNotifications()
                    ]);

                    // Оновлюємо статистику
                    updateClientStats(myLifts, myRequests);
                    
                    // Показуємо останні заявки
                    displayRecentRequests(myRequests);
                    
                    // Ініціалізуємо WebSocket
                    initClientWebSocket(userData);
                    
                    console.log('✅ Клієнтська панель ініціалізована');

                } catch (error) {
                    console.error('❌ Помилка ініціалізації клієнтської панелі:', error);
                    
                    // Fallback до локальних даних
                    const fallbackUser = JSON.parse(localStorage.getItem('currentUser')) || { 
                        firstName: 'Клієнт' 
                    };
                    updateClientInterface(fallbackUser);
                    initClientWebSocket(fallbackUser);
                }
            }

            /**
             * Завантаження профілю клієнта
             */
            async function loadClientProfile() {
                try {
                    const response = await window.authManager.apiRequest('/users/profile');
                    
                    if (response.ok) {
                        const userData = await response.json();
                        
                        // Зберігаємо в localStorage для офлайн доступу
                        localStorage.setItem('currentUser', JSON.stringify(userData));
                        
                        return userData;
                    }
                    
                    throw new Error('Помилка завантаження профілю');
                } catch (error) {
                    console.warn('API недоступний, використовуємо локальні дані');
                    return JSON.parse(localStorage.getItem('currentUser')) || { firstName: 'Клієнт' };
                }
            }

            /**
             * Завантаження ліфтів клієнта з MongoDB API
             */
            async function loadClientLifts() {
                try {
                    console.log('🔄 Завантаження ліфтів клієнта з API...');
                    const response = await AuthManager.fetchWithAuth('/api/lifts');
                    
                    if (!response.ok) {
                        throw new Error('Помилка завантаження ліфтів');
                    }

                    const data = await response.json();
                    console.log('✅ Ліфти завантажено:', data.data?.length || 0);
                    
                    // Отримуємо дані користувача для фільтрації
                    const userData = AuthManager.getCurrentUser();
                    const allLifts = data.data || [];
                    
                    // Фільтруємо ліфти за клієнтом (якщо потрібно)
                    const clientLifts = userData?.role === 'client' && userData?._id
                        ? allLifts.filter(lift => lift.client === userData._id || lift.clientId === userData._id)
                        : allLifts;
                    
                    return clientLifts;
                } catch (error) {
                    console.error('❌ Помилка завантаження ліфтів:', error);
                    return [];
                }
            }

            /**
             * Завантаження заявок клієнта
             * TODO: Реалізувати requests API в unified-server
             */
            async function loadClientRequests() {
                try {
                    console.log('🔄 Завантаження заявок клієнта...');
                    // TODO: Коли requests API буде готовий, розкоментувати:
                    // const response = await AuthManager.fetchWithAuth('/api/requests');
                    // const data = await response.json();
                    // return data.data || [];
                    
                    // Тимчасово: створюємо тестові дані
                    const userData = AuthManager.getCurrentUser();
                    const testRequests = [
                        {
                            _id: '1',
                            type: 'maintenance',
                            status: 'pending',
                            priority: 'medium',
                            description: 'Планове технічне обслуговування',
                            createdAt: new Date().toISOString(),
                            lift: { municipalNumber: '001' }
                        }
                    ];
                    
                    console.log('⚠️ Використовуються тестові дані для заявок');
                    return testRequests;
                } catch (error) {
                    console.error('❌ Помилка завантаження заявок:', error);
                    return [];
                }
            }

            /**
             * Завантаження сповіщень клієнта
             */
            async function loadClientNotifications() {
                try {
                    const response = await window.authManager.apiRequest('/notifications/client/my');
                    
                    if (response.ok) {
                        const data = await response.json();
                        const notifications = Array.isArray(data) ? data : data.notifications || [];
                        
                        // Оновлюємо лічильник сповіщень
                        const unreadCount = notifications.filter(n => !n.read).length;
                        $('#notificationCount').text(unreadCount);
                        
                        return notifications;
                    }
                    
                    return [];
                } catch (error) {
                    console.warn('API недоступний для сповіщень');
                    return [];
                }
            }

            /**
             * Оновлення інтерфейсу клієнта
             */
            function updateClientInterface(userData) {
                const fullName = `${userData.firstName || ''} ${userData.lastName || ''}`.trim() || 'Клієнт';
                
                $('#clientName').text(fullName);
                $('#userName').text(fullName);
                
                if (userData.email) {
                    $('.user-email').text(userData.email);
                }
                
                if (userData.phone) {
                    $('.user-phone').text(userData.phone);
                }
            }

            /**
             * Оновлення статистики клієнта
             */
            function updateClientStats(lifts, requests) {
                // Загальна кількість ліфтів
                $('#totalLifts').text(lifts.length);
                
                // Активні заявки
                const activeRequests = requests.filter(r => r.status === 'open' || r.status === 'in_progress').length;
                $('#activeRequests').text(activeRequests);
                
                // Завершені за місяць
                const oneMonthAgo = new Date();
                oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);
                
                const completedThisMonth = requests.filter(r => {
                    return r.status === 'completed' && 
                           new Date(r.updatedAt) > oneMonthAgo;
                }).length;
                $('#completedThisMonth').text(completedThisMonth);
                
                // Ліфти на обслуговуванні
                const liftsInMaintenance = lifts.filter(l => l.status === 'maintenance').length;
                $('#liftsInMaintenance').text(liftsInMaintenance);
            }

            /**
             * Відображення останніх заявок
             */
            function displayRecentRequests(requests) {
                const container = $('#recentRequestsContainer');
                
                if (!container.length) {
                    console.log('Контейнер для заявок не знайдено');
                    return;
                }

                container.empty();
                
                if (!requests || requests.length === 0) {
                    container.html(`
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle mr-2"></i>
                            У вас поки немає заявок
                        </div>
                    `);
                    return;
                }

                // Показуємо останні 5 заявок
                const recentRequests = requests
                    .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
                    .slice(0, 5);

                recentRequests.forEach(request => {
                    const statusBadge = getRequestStatusBadge(request.status);
                    const priorityBadge = getRequestPriorityBadge(request.priority);
                    
                    const requestCard = $(`
                        <div class="card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">${request.title || 'Заявка на обслуговування'}</h6>
                                        <small class="text-muted">
                                            ${request.lift?.address || 'Адреса не вказана'} • 
                                            ${new Date(request.createdAt).toLocaleDateString('uk-UA')}
                                        </small>
                                    </div>
                                    <div class="text-right">
                                        ${statusBadge}
                                        ${priorityBadge}
                                    </div>
                                </div>
                                ${request.description ? `<p class="mb-1 text-muted small">${request.description.substring(0, 100)}${request.description.length > 100 ? '...' : ''}</p>` : ''}
                            </div>
                        </div>
                    `);
                    
                    container.append(requestCard);
                });
            }

            /**
             * Допоміжні функції для статусів
             */
            function getRequestStatusBadge(status) {
                switch (status) {
                    case 'open':
                        return '<span class="badge badge-primary">Відкрита</span>';
                    case 'in_progress':
                        return '<span class="badge badge-warning">В роботі</span>';
                    case 'completed':
                        return '<span class="badge badge-success">Завершена</span>';
                    case 'cancelled':
                        return '<span class="badge badge-danger">Скасована</span>';
                    default:
                        return '<span class="badge badge-secondary">Невідомо</span>';
                }
            }

            function getRequestPriorityBadge(priority) {
                switch (priority) {
                    case 'high':
                        return '<span class="badge badge-danger ml-1">Високий</span>';
                    case 'medium':
                        return '<span class="badge badge-warning ml-1">Середній</span>';
                    case 'low':
                        return '<span class="badge badge-info ml-1">Низький</span>';
                    default:
                        return '';
                }
            }
            
            /**
             * Ініціалізація WebSocket для клієнтської панелі
             */
            function initClientWebSocket(user) {
                if (typeof UniversalWebSocketManager === 'undefined') {
                    console.warn('[Client Dashboard] UniversalWebSocketManager не знайдено');
                    return;
                }
                
                try {
                    window.clientWebSocket = new UniversalWebSocketManager('client', user.id || 'client_user');
                    
                    // Підписка на події
                    window.clientWebSocket.on('connected', function() {
                        console.log('[Client Dashboard] WebSocket підключено');
                        showNotification('Підключено до системи', 'success');
                    });
                    
                    window.clientWebSocket.on('request_status_update', function(data) {
                        console.log('[Client Dashboard] Оновлення статусу заявки:', data);
                        updateRequestStatus(data);
                        showNotification(`Заявка ${data.requestId}: ${data.status}`, 'info');
                    });
                    
                    window.clientWebSocket.on('lift_availability', function(data) {
                        console.log('[Client Dashboard] Оновлення доступності ліфтів:', data);
                        updateLiftStatus(data);
                    });
                    
                    window.clientWebSocket.on('service_notification', function(data) {
                        console.log('[Client Dashboard] Сервісне повідомлення:', data);
                        showNotification(data.message, data.type || 'info');
                    });
                    
                    window.clientWebSocket.on('disconnected', function() {
                        console.log('[Client Dashboard] WebSocket відключено');
                        showNotification('Відключено від системи', 'warning');
                    });
                    
                    window.clientWebSocket.on('error', function(error) {
                        console.error('[Client Dashboard] WebSocket помилка:', error);
                        showNotification('Помилка з\'єднання', 'error');
                    });
                    
                    // Підключення
                    window.clientWebSocket.connect();
                    
                } catch (error) {
                    console.error('[Client Dashboard] Помилка ініціалізації WebSocket:', error);
                }
            }
            
            /**
             * Оновлення статусу заявки в реальному часі
             */
            function updateRequestStatus(data) {
                const requestElement = document.querySelector(`[data-request-id="${data.requestId}"]`);
                if (requestElement) {
                    const statusElement = requestElement.querySelector('.status-badge');
                    if (statusElement) {
                        statusElement.textContent = data.status;
                        statusElement.className = `status-badge status-${data.status.toLowerCase()}`;
                    }
                }
            }
            
            /**
             * Оновлення статусу ліфтів
             */
            function updateLiftStatus(data) {
                if (data.liftId) {
                    const liftElement = document.querySelector(`[data-lift-id="${data.liftId}"]`);
                    if (liftElement) {
                        const statusElement = liftElement.querySelector('.lift-status');
                        if (statusElement) {
                            statusElement.textContent = data.status;
                            statusElement.className = `lift-status status-${data.status.toLowerCase()}`;
                        }
                    }
                }
            }
            
            /**
             * Відображення сповіщень
             */
            function showNotification(message, type = 'info') {
                const alertClass = {
                    'success': 'alert-success',
                    'info': 'alert-info',
                    'warning': 'alert-warning',
                    'error': 'alert-danger'
                }[type] || 'alert-info';
                
                const notification = $(`
                    <div class="alert ${alertClass} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                        ${message}
                        <button type="button" class="close" data-dismiss="alert">
                            <span>&times;</span>
                        </button>
                    </div>
                `);
                
                $('body').append(notification);
                
                // Автоматичне видалення через 5 секунд
                setTimeout(() => {
                    notification.alert('close');
                }, 5000);
            }
        });
    </script>
    <!-- AI Assistant Floating Button & Modal -->
    <link rel="stylesheet" href="/assets/css/ai-assistant.css">
    <div id="ai-assistant-fab" style="position:fixed;bottom:32px;right:32px;z-index:9999;">
        <button class="ai-fab-btn" title="AI Асистент" style="background:#3a86ff;color:#fff;border:none;border-radius:50%;width:56px;height:56px;box-shadow:0 2px 8px rgba(0,0,0,0.2);font-size:28px;cursor:pointer;">
            <i class="fas fa-robot"></i>
        </button>
    </div>
    <div id="ai-assistant-modal" style="display:none;position:fixed;bottom:100px;right:32px;z-index:10000;max-width:350px;width:100%;">
        <div class="ai-chat-container">
            <div class="ai-chat-header">
                <h4>AI Асистент</h4>
                <button class="ai-chat-close"><i class="fas fa-times"></i></button>
            </div>
            <div class="ai-chat-messages">
                <div class="ai-message ai-message-assistant">
                    <div class="ai-message-content">
                        <div class="ai-message-text">Привіт! Я ваш AI асистент. Чим можу допомогти?</div>
                        <div class="ai-message-time">Зараз</div>
                    </div>
                </div>
            </div>
            <div class="ai-chat-input">
                <textarea class="ai-message-input" placeholder="Напишіть повідомлення..."></textarea>
                <div class="ai-chat-actions">
                    <button class="ai-send-message"><i class="fas fa-paper-plane"></i> Надіслати</button>
                    <button class="ai-voice-toggle"><i class="fas fa-microphone"></i> Голос</button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="/assets/js/modules/ai-assistant.js"></script>
    <script>
        // Відкриття/закриття модального вікна
        const fabBtn = document.getElementById('ai-assistant-fab');
        const modal = document.getElementById('ai-assistant-modal');
        fabBtn.onclick = () => { modal.style.display = 'block'; };
        document.querySelector('.ai-chat-close').onclick = () => { modal.style.display = 'none'; };
    </script>
    </body>
</html>
<!-- AI Assistant Include -->
<!--#include file="../../templates/ai-assistant-include.html" -->
<!-- Якщо сервер не підтримує include, вставте вміст ai-assistant-include.html вручну перед </body> -->