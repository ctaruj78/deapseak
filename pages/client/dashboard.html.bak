                                    Детальніше <i class="fas fa-arrow-circle-right"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-6">
                            <div class="small-box bg-success card-client">
                                <div class="inner">
                                    <h3 id="operationalLifts">0</h3>
                                    <p>Працюють нормально</p>
                                </div>
                                <div class="icon">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                                <a href="my-lifts.html?status=active" class="small-box-footer">
                                    Детальніше <i class="fas fa-arrow-circle-right"></i>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-6">
                            <div class="small-box bg-warning card-client">
                                <div class="inner">
                                    <h3 id="maintenanceLifts">0</h3>
