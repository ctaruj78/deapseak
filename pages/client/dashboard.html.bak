                            <div class="card card-client">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-history mr-2"></i>Останні події</h3>
                                    <div class="card-tools">
                                        <button class="btn btn-sm btn-default" onclick="window.clientDashboard?.refreshActivities()">
                                            <i class="fas fa-sync"></i> Оновити
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Подія</th>
                                                    <th>Статус</th>
                                                    <th>Час</th>
                                                    <th>Дія</th>
                                                </tr>
                                            </thead>
                                            <tbody id="recentActivityList">
                                                <!-- Activities will be loaded here -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="card-footer text-center">
                                    <a href="history.html" class="btn btn-sm btn-default">
                                        <i class="fas fa-list"></i> Вся історія
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="col-lg-4">
                            <div class="card card-client">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-bolt mr-2"></i>Швидкі дії</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row text-center">
                                        <div class="col-6 mb-3">
                                            <div class="action-button bg-primary text-white">
                                                <i class="fas fa-plus-circle action-icon"></i>
                                                <h5>Нова заявка</h5>
                                                <p>Створення нової заявки</p>
                                                <button class="btn btn-light btn-sm" onclick="location.href='requests.html?new=true'">
                                                    Створити
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="action-button bg-success text-white">
                                                <i class="fas fa-building action-icon"></i>
                                                <h5>Мої ліфти</h5>
                                                <p>Перегляд усіх ліфтів</p>
                                                <button class="btn btn-light btn-sm" onclick="location.href='my-lifts.html'">
                                                    Переглянути
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="action-button bg-info text-white">
                                                <i class="fas fa-file-invoice action-icon"></i>
                                                <h5>Рахунки</h5>
                                                <p>Перегляд рахунків</p>
                                                <button class="btn btn-light btn-sm" onclick="location.href='invoices.html'">
                                                    Переглянути
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="action-button bg-warning text-dark">
                                                <i class="fas fa-headset action-icon"></i>
                                                <h5>Підтримка</h5>
                                                <p>Зв'язатися з підтримкою</p>
                                                <button class="btn btn-dark btn-sm" onclick="location.href='support.html'">
                                                    Зв'язатися
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
