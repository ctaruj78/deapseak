                    <!-- Notifications and Alerts -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card card-client">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-bell mr-2"></i>Останні сповіщення</h3>
                                    <div class="card-tools">
                                        <span class="badge badge-danger" id="alertsCount">0</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div id="notificationsList">
                                        <!-- Notifications will be loaded here -->
                                    </div>
                                </div>
                                <div class="card-footer text-center">
                                    <a href="notifications.html" class="btn btn-sm btn-default">
                                        <i class="fas fa-bell"></i> Всі сповіщення
