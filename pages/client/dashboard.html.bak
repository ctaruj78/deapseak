                                    <h3 class="card-title"><i class="fas fa-chart-pie mr-2"></i>Статистика ліфтів</h3>
                                </div>
                                <div class="card-body">
                                    <div class="chart-container">
                                        <canvas id="liftsChart" height="250"></canvas>
                                    </div>
