                                </div>
                                <div class="icon">
                                    <i class="fas fa-tools"></i>
                                </div>
                                <a href="my-lifts.html?status=maintenance" class="small-box-footer">
                                    Детальніше <i class="fas fa-arrow-circle-right"></i>
                                </a>
                            </div>
                        </div>
