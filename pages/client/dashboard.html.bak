                                                <span class="weather-temp">+22°C</span>
                                                <br>
                                                <small class="weather-desc">Хмарно</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Statistics Cards -->
                    <div class="row">
                        <div class="col-lg-3 col-6">
                            <div class="small-box bg-info card-client">
                                <div class="inner">
                                    <h3 id="totalLifts">0</h3>
                                    <p>Моїх ліфтів</p>
