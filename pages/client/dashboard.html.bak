                            <div class="small-box bg-primary card-client">
                                <div class="inner">
                                    <h3 id="activeRequests">0</h3>
                                    <p>Активні заявки</p>
                                </div>
                                <div class="icon">
                                    <i class="fas fa-clipboard-list"></i>
                                </div>
                                <a href="requests.html" class="small-box-footer">
