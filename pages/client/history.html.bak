                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" onclick="logout()" title="Вийти">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Бічна панель -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="dashboard.html" class="brand-link text-center">
                <span class="brand-text font-weight-light">Клієнт</span>
            </a>
            
            <div class="sidebar">
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="../../assets/img/avatars/client.png" class="img-circle elevation-2" alt="Client">
                    </div>
                    <div class="info">
                        <a href="#" class="d-block" id="clientName">Клієнт</a>
                        <small class="text-success"><i class="fas fa-circle mr-1"></i> Online</small>
                    </div>
                </div>
                
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="dashboard.html" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Головна</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="my-lifts.html" class="nav-link">
                                <i class="nav-icon fas fa-elevator"></i>
                                <p>Мої ліфти</p>
                                <span class="badge badge-info right" id="liftsCount">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="requests.html" class="nav-link">
                                <i class="nav-icon fas fa-tasks"></i>
                                <p>Мої заявки</p>
                                <span class="badge badge-warning right" id="requestsCount">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="invoices.html" class="nav-link">
                                <i class="nav-icon fas fa-file-invoice"></i>
                                <p>Рахунки</p>
                                <span class="badge badge-success right" id="invoicesCount">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="history.html" class="nav-link active">
                                <i class="nav-icon fas fa-history"></i>
                                <p>Історія</p>
                                <span class="badge badge-primary right" id="historyCount">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="notifications.html" class="nav-link">
                                <i class="nav-icon fas fa-bell"></i>
                                <p>Сповіщення</p>
                                <span class="badge badge-danger right" id="notificationsBadge">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="support.html" class="nav-link">
                                <i class="nav-icon fas fa-headset"></i>
                                <p>Підтримка</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="profile.html" class="nav-link">
                                <i class="nav-icon fas fa-user"></i>
                                <p>Профіль</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>Історія обслуговування</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a href="dashboard.html">Головна</a></li>
                                <li class="breadcrumb-item active">Історія</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    <!-- Фільтри -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card history-card">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-filter mr-2"></i>Фільтри історії</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Період:</label>
                                                <select id="periodFilter" class="form-control">
                                                    <option value="30">Останні 30 днів</option>
                                                    <option value="90">Останні 3 місяці</option>
                                                    <option value="365">Останній рік</option>
                                                    <option value="all">Вся історія</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Тип події:</label>
                                                <select id="eventTypeFilter" class="form-control">
                                                    <option value="all">Всі події</option>
                                                    <option value="maintenance">Технічне обслуговування</option>
                                                    <option value="repair">Ремонт</option>
                                                    <option value="inspection">Інспекція</option>
                                                    <option value="emergency">Аварійне обслуговування</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Ліфт:</label>
                                                <select id="liftFilter" class="form-control">
                                                    <option value="all">Всі ліфти</option>
                                                    <option value="lift1">Otis Gen2 - вул. Центральна, 12</option>
                                                    <option value="lift2">Schindler 3300 - пр. Перемоги, 45</option>
                                                    <option value="lift3">KONE MonoSpace - вул. Шевченка, 78</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group" style="margin-top: 32px;">
                                                <button class="btn btn-primary" onclick="historyManager.applyFilters()">
                                                    <i class="fas fa-filter"></i> Застосувати
                                                </button>
                                                <button class="btn btn-default" onclick="historyManager.resetFilters()">
                                                    <i class="fas fa-sync"></i> Скинути
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Статистика -->
                    <div class="row">
                        <div class="col-lg-3 col-md-6">
                            <div class="stat-card">
                                <div class="stat-icon">📋</div>
                                <div class="stat-info">
                                    <h3 id="totalEvents">0</h3>
                                    <p>Всього подій</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="stat-card">
                                <div class="stat-icon">🔧</div>
                                <div class="stat-info">
                                    <h3 id="maintenanceCount">0</h3>
                                    <p>Технічних обслуговувань</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="stat-card">
                                <div class="stat-icon">⏱️</div>
                                <div class="stat-info">
                                    <h3 id="avgResponseTime">0</h3>
                                    <p>Середній час реакції</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="stat-card">
                                <div class="stat-icon">⭐</div>
                                <div class="stat-info">
                                    <h3 id="avgRating">0</h3>
                                    <p>Середня оцінка</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Таймлайн -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card history-card">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-stream mr-2"></i>Хронологія подій</h3>
                                    <div class="card-tools">
                                        <span class="badge badge-primary" id="timelineCount">0</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="timeline" id="timeline">
                                        <!-- Події будуть завантажені тут -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Детальна статистика -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card history-card">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-chart-bar mr-2"></i>Детальна статистика</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-4">
                                            <div class="chart-container">
                                                <h5>Розподіл по типах подій</h5>
                                                <canvas id="eventTypeChart" height="250"></canvas>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <div class="chart-container">
                                                <h5>Частота обслуговування</h5>
                                                <canvas id="frequencyChart" height="250"></canvas>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <div class="chart-container">
                                                <h5>Оцінки якості</h5>
                                                <canvas id="ratingsChart" height="250"></canvas>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-4">
                                            <div class="chart-container">
                                                <h5>Витрати на обслуговування</h5>
                                                <canvas id="costsChart" height="250"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Експорт -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card history-card">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fas fa-download mr-2"></i>Експорт історії</h3>
                                </div>
                                <div class="card-body">
                                    <div class="export-options">
                                        <button class="btn btn-primary export-btn" onclick="historyManager.exportToPDF()">
                                            <i class="fas fa-file-pdf fa-2x mb-2"></i>
                                            <h5>Експорт в PDF</h5>
                                            <small>Зберегти у форматі PDF</small>
                                        </button>
                                        <button class="btn btn-success export-btn" onclick="historyManager.exportToExcel()">
                                            <i class="fas fa-file-excel fa-2x mb-2"></i>
                                            <h5>Експорт в Excel</h5>
                                            <small>Зберегти у форматі Excel</small>
                                        </button>
                                        <button class="btn btn-info export-btn" onclick="historyManager.printHistory()">
                                            <i class="fas fa-print fa-2x mb-2"></i>
                                            <h5>Друк</h5>
                                            <small>Роздрукувати історію</small>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>Клієнтська панель &copy; 2024</strong>
            <div class="float-right d-none d-sm-inline-block">
                <small id="connectionStatus"><i class="fas fa-wifi text-success"></i> Online</small>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>

    <!-- History Manager JS -->
    <script src="../../assets/js/modules/history-manager.js"></script>

    <script>
        function logout() {
            if (confirm('Ви впевнені, що хочете вийти з системи?')) {
                localStorage.removeItem('authToken');
                localStorage.removeItem('userData');
                window.location.href = '../../login.html';
            }
        }

        $(document).ready(function() {
            // Ініціалізація AdminLTE
            $('[data-widget="pushmenu"]').PushMenu();
            
            // Темна тема
            $('#darkModeToggle').on('click', function() {
                $('body').toggleClass('dark-mode');
                $(this).find('i').toggleClass('fa-moon fa-sun');
            });

            // Перевірка з'єднання
            setInterval(() => {
                const online = navigator.onLine;
                $('#connectionStatus').html(
                    online ? 
                    '<i class="fas fa-wifi text-success"></i> Online' : 
                    '<i class="fas fa-wifi-slash text-danger"></i> Offline'
                );
            }, 30000);

            // Завантаження даних користувача
            const userData = JSON.parse(localStorage.getItem('userData')) || {};
            if (userData.firstName) {
                $('#clientName').text(`${userData.firstName} ${userData.lastName || ''}`);
            }

            // Ініціалізація менеджера історії
            window.historyManager = new HistoryManager();
        });
    </script>
</body>
    <!-- AI Assistant Floating Button & Modal -->
    <link rel="stylesheet" href="/assets/css/ai-assistant.css">
    <div id="ai-assistant-fab" style="position:fixed;bottom:32px;right:32px;z-index:9999;">
        <button class="ai-fab-btn" title="AI Асистент" style="background:#3a86ff;color:#fff;border:none;border-radius:50%;width:56px;height:56px;box-shadow:0 2px 8px rgba(0,0,0,0.2);font-size:28px;cursor:pointer;">
            <i class="fas fa-robot"></i>
        </button>
    </div>
    <div id="ai-assistant-modal" style="display:none;position:fixed;bottom:100px;right:32px;z-index:10000;max-width:350px;width:100%;">
        <div class="ai-chat-container">
            <div class="ai-chat-header">
                <h4>AI Асистент</h4>
                <button class="ai-chat-close"><i class="fas fa-times"></i></button>
            </div>
            <div class="ai-chat-messages">
                <div class="ai-message ai-message-assistant">
                    <div class="ai-message-content">
                        <div class="ai-message-text">Привіт! Я ваш AI асистент. Чим можу допомогти?</div>
                        <div class="ai-message-time">Зараз</div>
                    </div>
                </div>
            </div>
            <div class="ai-chat-input">
                <textarea class="ai-message-input" placeholder="Напишіть повідомлення..."></textarea>
                <div class="ai-chat-actions">
                    <button class="ai-send-message"><i class="fas fa-paper-plane"></i> Надіслати</button>
                    <button class="ai-voice-toggle"><i class="fas fa-microphone"></i> Голос</button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="/assets/js/modules/ai-assistant.js"></script>
    <script>
        // Відкриття/закриття модального вікна
        const fabBtn = document.getElementById('ai-assistant-fab');
        const modal = document.getElementById('ai-assistant-modal');
        fabBtn.onclick = () => { modal.style.display = 'block'; };
        document.querySelector('.ai-chat-close').onclick = () => { modal.style.display = 'none'; };
    </script>
</html>
<!-- AI Assistant Include -->
<!--#include file="../../templates/ai-assistant-include.html" -->
<!-- Якщо сервер не підтримує include, вставте вміст ai-assistant-include.html вручну перед </body> -->