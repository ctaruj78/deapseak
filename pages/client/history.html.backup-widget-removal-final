            font-size: 2.5rem;
            margin-bottom: 15px;
            display: block;
        }
        
        .timeline {
            position: relative;
            padding: 20px 0;
        }
        
        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            width: 2px;
            height: 100%;
            background: #007bff;
            transform: translateX(-50%);
        }
        
        .timeline-item {
            display: flex;
            justify-content: flex-end;
            padding-right: 30px;
            position: relative;
            margin-bottom: 40px;
            width: 50%;
        }
        
        .timeline-item:nth-child(even) {
            align-self: flex-end;
            justify-content: flex-start;
            padding-left: 30px;
            padding-right: 0;
            left: 50%;
        }
        
        .timeline-content {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            width: 100%;
            position: relative;
        }
        
        .timeline-content::after {
            content: '';
            position: absolute;
            top: 20px;
            right: -10px;
            width: 0;
            height: 0;
            border-top: 10px solid transparent;
            border-bottom: 10px solid transparent;
            border-left: 10px solid white;
        }
        
        .timeline-item:nth-child(even) .timeline-content::after {
            right: auto;
            left: -10px;
            border-left: none;
            border-right: 10px solid white;
        }
        
        .timeline-date {
            background: #007bff;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            position: absolute;
            top: 10px;
            right: -70px;
            font-weight: bold;
        }
        
        .timeline-item:nth-child(even) .timeline-date {
            right: auto;
            left: -70px;
        }
        
        .timeline-icon {
            font-size: 1.5rem;
            margin-bottom: 10px;
        }
        
        .status-completed {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            display: inline-block;
            font-size: 0.85rem;
        }
        
        .status-pending {
            background: linear-gradient(135deg, #ffc107, #fd7e14);
            color: #212529;
            padding: 5px 15px;
            border-radius: 20px;
            display: inline-block;
