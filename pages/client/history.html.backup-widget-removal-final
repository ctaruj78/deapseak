<!-- Скрипт для підсвічування активного пункту -->
<script>
(function() {
    // Визначити поточну сторінку
    const currentPage = window.location.pathname.split('/').pop().replace('.html', '');
    
    // Мапінг сторінок на ID навігації
    const pageMap = {
        'dashboard': 'nav-dashboard',
        'my-lifts': 'nav-my-lifts',
        'ai-predictions': 'nav-ai-predictions',
        'requests': 'nav-requests',
        'invoices': 'nav-invoices',
        'history': 'nav-history',
        'documentation': 'nav-documentation',
        'ai-assistant': 'nav-ai-assistant',
        'notifications': 'nav-notifications',
        'support': 'nav-support',
        'profile': 'nav-profile',
        'settings': 'nav-settings'
    };
    
    // Підсвітити активний пункт
    const activeNav = pageMap[currentPage];
    if (activeNav) {
        const navLink = document.getElementById(activeNav);
        if (navLink) {
            navLink.classList.add('active');
        }
    }
    
    // Завантажити лічильники з API
    loadClientCounts();
    
    function loadClientCounts() {
        const token = localStorage.getItem('token');
        if (!token) return;
        
        // Кількість ліфтів
        fetch('/api/lifts', {
            headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
            if (data.data && Array.isArray(data.data)) {
                const count = data.data.length;
                const badge = document.getElementById('liftsCount');
                if (badge) badge.textContent = count;
            }
        })
        .catch(err => console.warn('Failed to load lifts count:', err));
        
        // Кількість заявок
        fetch('/api/requests?status=pending,in_progress', {
            headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
            if (data.data && Array.isArray(data.data)) {
                const count = data.data.length;
                const badge = document.getElementById('requestsCount');
                if (badge) badge.textContent = count;
            }
        })
        .catch(err => console.warn('Failed to load requests count:', err));
        
        // Кількість рахунків
        fetch('/api/invoices?status=unpaid', {
            headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
            if (data.data && Array.isArray(data.data)) {
                const count = data.data.length;
                const badge = document.getElementById('invoicesCount');
                if (badge) badge.textContent = count;
            }
        })
        .catch(err => console.warn('Failed to load invoices count:', err));
        
        // Кількість сповіщень
        fetch('/api/notifications?unread=true', {
            headers: { 'Authorization': `Bearer ${token}` }
        })
        .then(res => res.json())
        .then(data => {
            if (data.data && Array.isArray(data.data)) {
                const count = data.data.length;
                const badge = document.getElementById('notificationsBadge');
                if (badge) {
                    badge.textContent = count;
                    badge.style.display = count > 0 ? 'inline-block' : 'none';
                }
            }
        })
        .catch(err => console.warn('Failed to load notifications count:', err));
    }
    
    // Оновлювати лічильники кожні 30 секунд
    setInterval(loadClientCounts, 30000);
})();
</script>

