                        </div>
                    </div>

                    <!-- Map Controls -->
                    <div class="map-controls">
                        <div class="row">
                            <div class="col-md-4">
                                <label for="statusFilter">Фільтр за статусом:</label>
                                <select class="form-control" id="statusFilter">
                                    <option value="all">Всі ліфти</option>
                                    <option value="active">Активні</option>
                                    <option value="maintenance">На обслуговуванні</option>
                                    <option value="inactive">З несправностями</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="routeToLift">Прокласти маршрут до ліфта:</label>
                                <select id="routeToLift" class="form-control">
                                    <option value="">Оберіть ліфт</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>&nbsp;</label>
                                <button id="btnRoute" class="btn btn-primary btn-block">
                                    <i class="fas fa-route"></i> Показати маршрут
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Map Container -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Інтерактивна мапа ліфтів</h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <button type="button" class="btn btn-tool" data-card-widget="maximize">
                                    <i class="fas fa-expand"></i>
