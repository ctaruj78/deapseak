                           `Estas correções devem ser incluídas no plano de manutenção:\n\n` +
                           minorViolations.map((v, i) => 
                               `${i + 1}. ${v.articleInfo.title} (${v.articleKey})\n` +
                               `   - Ajuste necessário: ${v.description}\n` +
                               `   - Importância: ${v.articleInfo.why}\n` +
                               `   - Como resolver: ${v.articleInfo.solution}`
                           ).join('\n\n');
            
            const date = new Date();
            date.setDate(date.getDate() + 90);
            nextInspectionDate = date.toLocaleDateString('pt-PT') + ' (após 90 dias)';
            estimatedCost = 'Baixo - Entre €100 e €800 para todas as correções';
            legalRisks = 'ℹ️ RISCO LEGAL BAIXO:\n' +
                        '- Advertência administrativa possível\n' +
                        '- Coimas pequenas se repetido (€100 - €500)';
            safetyRisks = 'ℹ️ RISCO DE SEGURANÇA BAIXO:\n' +
                         '- Não há risco imediato\n' +
                         '- Deve ser corrigido para conformidade total';
            
            recommendations.push('1. Incluir correções na próxima manutenção programada');
            recommendations.push('2. Não há necessidade de parar o equipamento');
            recommendations.push('3. Documentar as correções quando realizadas');
            recommendations.push('4. Agendar inspeção regular no prazo legal');
            
        } else {
            urgencyLevel = '🟢 CONFORME';
            
            // Build detailed message based on certificate metadata
            let certInfo = '';
            if (metadata.liftNumber) {
                certInfo += `📍 Elevador: ${metadata.liftNumber}\n`;
            }
            if (metadata.location) {
                certInfo += `📍 Localização: ${metadata.location}\n`;
            }
            if (metadata.company) {
                certInfo += `🏢 Empresa: ${metadata.company}\n`;
            }
            if (metadata.technician) {
                certInfo += `👨‍🔧 Técnico: ${metadata.technician}\n`;
            }
            
            if (certInfo) {
                certInfo += '\n';
            }
            
            actionRequired = '✅ CERTIFICADO DE INSPEÇÃO APROVADO\n\n' +
                           certInfo +
                           '✅ Nenhuma não conformidade detectada.\n' +
                           'O elevador encontra-se em conformidade com o regulamento.\n\n' +
                           '🔧 Recomendações de manutenção preventiva:\n' +
                           '• Continuar manutenção mensal regular\n' +
                           '• Manter documentação atualizada\n' +
                           '• Registar todas as intervenções\n' +
                           '• Preparar para próxima inspeção anual\n\n' +
                           '📚 Base legal: Decreto-Lei 320/2002, Anexo V';
            
            const date = new Date();
            date.setFullYear(date.getFullYear() + 1);
            nextInspectionDate = date.toLocaleDateString('pt-PT') + ' (inspeção anual)';
            estimatedCost = 'Apenas manutenção preventiva regular (€50-150/mês)';
            legalRisks = '✅ SEM RISCOS LEGAIS:\n• Equipamento em conformidade\n• Continuar boas práticas de manutenção';
            safetyRisks = '✅ EQUIPAMENTO SEGURO:\n• Funcionamento normal\n• Risco mínimo\n• Apto para exploração';
            
            recommendations.push('1. Manter programa de manutenção preventiva');
            recommendations.push('2. Atualizar documentação técnica regularmente');
            recommendations.push('3. Treinar utilizadores sobre uso correto');
            recommendations.push('4. Preparar orçamento para inspeção anual');
        }
        
        // Build detailed summary
        const detailedSummary = {
            totalViolations: violations.length,
            breakdown: {
                critical: {
                    count: criticalViolations.length,
                    percentage: violations.length > 0 ? Math.round((criticalViolations.length / violations.length) * 100) : 0,
                    items: criticalViolations.map(v => ({
                        article: v.articleKey,
                        title: v.articleInfo.title,
                        problem: v.description
                    }))
                },
                major: {
                    count: majorViolations.length,
                    percentage: violations.length > 0 ? Math.round((majorViolations.length / violations.length) * 100) : 0,
                    items: majorViolations.map(v => ({
                        article: v.articleKey,
                        title: v.articleInfo.title,
                        problem: v.description
                    }))
                },
                minor: {
                    count: minorViolations.length,
                    percentage: violations.length > 0 ? Math.round((minorViolations.length / violations.length) * 100) : 0,
                    items: minorViolations.map(v => ({
                        article: v.articleKey,
                        title: v.articleInfo.title,
                        problem: v.description
                    }))
                }
            }
        };
        
        return {
            // Basic info
            approved: !hasCritical,
            urgencyLevel,
            actionRequired,
            nextInspectionDate,
            
            // Counts
            criticalCount: criticalViolations.length,
            majorCount: majorViolations.length,
            minorCount: minorViolations.length,
            totalCount: violations.length,
            
            // Detailed analysis
            estimatedCost,
            legalRisks,
            safetyRisks,
            recommendations,
            detailedSummary,
            
            // Generated info
            generatedAt: new Date().toISOString(),
            validUntil: nextInspectionDate
        };
    }

    /**
     * Clean up uploaded file
     * @param {string} filePath - Path to file to delete
     */
    async cleanupFile(filePath) {
        try {
            await fs.unlink(filePath);
        } catch (error) {
            console.error('File cleanup error:', error);
        }
    }
}

module.exports = new PDFParserService();
