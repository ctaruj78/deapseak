    /**
     * Extract certificate metadata from text
     * @param {string} text - PDF text content
     * @returns {Object} Metadata object
     */
    extractMetadata(text) {
        const metadata = {
            certificateType: 'unknown',
            liftNumber: null,
            location: null,
            inspectionDate: null,
            company: null,
            technician: null,
            status: 'unknown'
        };
        
        // Detect certificate type
        if (/CERTIFICADO DE INSPEÇÃO PERIÓDICA/i.test(text)) {
            metadata.certificateType = 'periodic_inspection';
        } else if (/NOTA DE CLÁUSULAS/i.test(text)) {
            metadata.certificateType = 'clause_notice';
        }
        
        // Extract lift number
        const liftMatch = text.match(/ELEVADOR\s+N[ºª°]?\s*:?\s*([A-Z0-9\-\/]+)/i);
        if (liftMatch) {
            metadata.liftNumber = liftMatch[1].trim();
        }
        
        // Extract location/address
        const locationMatch = text.match(/LOCALIZAÇÃO\s*:?\s*(.{10,100}?)(?:\n|PROPRIETÁRIO|EMPRESA)/i);
        if (locationMatch) {
            metadata.location = locationMatch[1].trim();
        }
        
        // Extract company
        const companyMatch = text.match(/EMPRESA\s+DE\s+MANUTENÇÃO\s*:?\s*(.{5,80}?)(?:\n|TÉCNICO|CLÁUSULAS)/i);
        if (companyMatch) {
            metadata.company = companyMatch[1].trim();
        }
        
        // Extract technician
        const techMatch = text.match(/TÉCNICO\s*:?\s*(.{5,60}?)(?:\n|CLÁUSULAS|C[123])/i);
        if (techMatch) {
            metadata.technician = techMatch[1].trim();
        }
        
        // Determine status
        if (/autorizada.*manutenção em exploração/i.test(text) || 
            /APROVADO/i.test(text) ||
            /conforme/i.test(text)) {
            metadata.status = 'approved';
        } else if (/NÃO APROVADO/i.test(text) || 
                   /não conforme/i.test(text) ||
                   /CLÁUSULAS DE CUMPRIMENTO OBRIGATÓRIO/i.test(text)) {
            metadata.status = 'with_clauses';
        }
        
        console.log('📋 Extracted metadata:', metadata);
        return metadata;
    }

    /**
     * Extract violations from text
     * @param {string} text - PDF text content
     * @returns {Array<Object>} Violations array
     */
    extractViolations(text) {
        const violations = [];
        const lines = text.split('\n');
        
        let currentViolation = null;
        
        for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            
            // Check if line starts with classification (C1, C2, C3)
            const classMatch = line.match(/^(C[123])\s*-\s*Art\.º\s*(\d+)\s*-\s*(.+)$/i);
            
            if (classMatch) {
                // Save previous violation if exists
                if (currentViolation) {
                    violations.push(currentViolation);
                }
                
                // Start new violation
                const articleKey = `Art.º ${classMatch[2]}`;
                const articleInfo = this.regulationArticles[articleKey] || {
                    title: 'Artigo não catalogado',
                    fullName: `Artigo ${classMatch[2]}`,
                    description: 'Consultar regulamentação completa',
                    why: 'Verificar detalhes na norma técnica',
                    consequence: 'Não conformidade com requisitos legais',
                    solution: 'Consultar técnico certificado',
                    urgency: 'Avaliar com especialista'
                };

                const classificationInfo = this.classificationInfo[classMatch[1].toUpperCase()] || {};

                currentViolation = {
                    // Basic info
                    classification: classMatch[1].toUpperCase(),
                    article: classMatch[2],
                    articleKey: articleKey,
                    description: classMatch[3].trim(),
                    details: '',
                    
                    // Classification details
                    classificationInfo: {
                        level: classificationInfo.level || 'DESCONHECIDO',
                        color: classificationInfo.color || 'gray',
                        icon: classificationInfo.icon || '⚪',
                        meaning: classificationInfo.meaning || 'Classificação a determinar',
                        action: classificationInfo.action || 'Consultar técnico',
                        deadline: classificationInfo.deadline || 'A determinar',
                        legalConsequence: classificationInfo.legalConsequence || 'Verificar legislação'
                    },
                    
                    // Article explanation
                    articleInfo: {
                        title: articleInfo.title,
                        fullName: articleInfo.fullName,
                        description: articleInfo.description,
                        why: articleInfo.why,
                        consequence: articleInfo.consequence,
                        solution: articleInfo.solution,
                        urgency: articleInfo.urgency
                    }
                };
            } else if (currentViolation && line.length > 0 && !line.match(/^(RELATÓRIO|CONCLUSÃO|Art\.º)/i)) {
                // Add details to current violation
                currentViolation.details += (currentViolation.details ? ' ' : '') + line;
            }
        }
        
        // Add last violation
        if (currentViolation) {
            violations.push(currentViolation);
        }
        
        // If no structured violations found, try to extract from unstructured text
        if (violations.length === 0) {
            return this.extractUnstructuredViolations(text);
        }
        
        return violations;
    }

    /**
     * Extract violations from unstructured text
     * @param {string} text - PDF text content
     * @returns {Array<Object>} Violations array
     */
    extractUnstructuredViolations(text) {
        const violations = [];
        
        // First check if this is a clean certificate
        const cleanPatterns = [
            /autorizada.*manutenção em exploração/i,
            /CERTIFICADO DE INSPEÇÃO PERIÓDICA/i,
            /manutenção em exploração/i,
            /conformidade.*regulamento/i
        ];
        
        const isCleanCertificate = cleanPatterns.some(pattern => pattern.test(text));
        
        if (isCleanCertificate) {
            console.log('✅ Clean certificate detected - no violations');
            return violations; // Return empty array for clean certificates
        }
        
        // Look for explicit clause markers in the text
        const clausePatterns = [
            /CLÁUSULAS?\s+DE\s+CUMPRIMENTO\s+OBRIGATÓRIO/i,
            /NOTA\s+DE\s+CLÁUSULAS/i,
            /NÃO\s+CONFORMIDADES?/i
        ];
        
        const hasClauseSection = clausePatterns.some(pattern => pattern.test(text));
        
        if (!hasClauseSection) {
            console.log('ℹ️ No clause section found - likely a clean certificate');
            return violations;
        }
        
        // Look for actual C1/C2/C3 classifications in text
        const classificationMatches = text.matchAll(/\b(C[123])\b/g);
        const foundClasses = [...classificationMatches];
        
        if (foundClasses.length === 0) {
            console.log('ℹ️ No C1/C2/C3 classifications found');
            return violations;
        }
        
        // Process each classification found
        foundClasses.forEach((match, idx) => {
            const classification = match[1];
            const position = match.index;
            
            // Get context around the classification
            const contextStart = Math.max(0, position - 50);
            const contextEnd = Math.min(text.length, position + 300);
            const context = text.substring(contextStart, contextEnd);
            
            // Try to find article number near the classification
            const articleMatch = context.match(/Art\.?º?\s*(\d+)|artigo\s*(\d+)/i);
            const articleNum = articleMatch ? (articleMatch[1] || articleMatch[2]) : '0';
            const articleKey = `Art.º ${articleNum}`;
            
            // Extract description - get the text after C1/C2/C3
            const descriptionMatch = context.substring(position).match(/C[123]\s*[-–—]?\s*(.{10,200}?)(?:\n|$|C[123])/);
            const description = descriptionMatch ? descriptionMatch[1].trim() : 'Não conformidade detectada';
            
            const articleInfo = this.regulationArticles[articleKey] || {
                title: `Artigo ${articleNum}`,
                fullName: `Regulamento - Artigo ${articleNum}`,
                description: 'Consultar regulamentação completa',
                why: 'Verificar detalhes na norma técnica',
                consequence: 'Não conformidade com requisitos legais',
                solution: 'Consultar técnico certificado para correção',
                urgency: 'Avaliar gravidade com especialista'
            };

            const classificationInfo = this.classificationInfo[classification] || {};

            violations.push({
                classification,
                article: articleNum,
                articleKey,
                description,
                details: context.trim(),
                classificationInfo: {
                    level: classificationInfo.level || 'DESCONHECIDO',
                    color: classificationInfo.color || 'gray',
                    icon: classificationInfo.icon || '⚪',
                    meaning: classificationInfo.meaning || 'Classificação a determinar',
                    action: classificationInfo.action || 'Consultar técnico',
                    deadline: classificationInfo.deadline || 'A determinar',
                    legalConsequence: classificationInfo.legalConsequence || 'Verificar legislação'
                },
                articleInfo: {
                    title: articleInfo.title,
                    fullName: articleInfo.fullName,
                    description: articleInfo.description,
                    why: articleInfo.why,
                    consequence: articleInfo.consequence,
                    solution: articleInfo.solution,
                    urgency: articleInfo.urgency
                }
            });
        });
        
        console.log(`🔍 Found ${violations.length} violation(s) in unstructured text`);
        return violations;
    }

